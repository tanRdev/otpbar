{
  "name": "otpbar",
  "version": "1.0.0",
  "description": "Menubar app that monitors Gmail for OTP codes and copies them to clipboard",
  "type": "module",
  "engines": {
    "node": "24.18.0",
    "npm": "11.16.0"
  },
  "scripts": {
    "preinstall": "node scripts/check-toolchain.mjs",
    "toolchain:check": "node scripts/check-toolchain.mjs",
    "dev": "vite",
    "build": "npm run typecheck && npm run frontend:build",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/check-toolchain*.mjs\" \"*.{js,json,md}\" \".github/**/*.{yml,yaml}\"",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:frontend",
    "test:frontend": "vitest run",
    "frontend:build": "vite build",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml --all-features",
    "rust:build": "cargo build --manifest-path src-tauri/Cargo.toml --all-targets --all-features",
    "rust:security-audit": "./scripts/audit-rust.sh",
    "workflows:validate": "go run github.com/rhysd/actionlint/cmd/actionlint@v1.7.12",
    "security:audit": "npm audit",
    "verify:code": "npm run format:check && npm run lint && npm run typecheck && npm run test:frontend && npm run frontend:build && npm run rust:fmt && npm run rust:clippy && npm run rust:test && npm run rust:build && npm run rust:security-audit && npm run workflows:validate && npm run security:audit",
    "verify:bundle": "CI=true npm run tauri build",
    "verify": "npm run toolchain:check && npm run verify:code && npm run verify:bundle",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "author": "Tan R. <tanRdev@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tanRdev/otpbar"
  },
  "homepage": "https://github.com/tanRdev/otpbar#readme",
  "bugs": {
    "url": "https://github.com/tanRdev/otpbar/issues"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^25.0.9",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "^10.4.23",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "postcss": "8.5.22",
    "prettier": "3.9.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  }
}
