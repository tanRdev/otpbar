{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Limits the sole OTPBar webview to its explicitly declared application commands; clipboard plugin commands remain unavailable to web content.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-codes",
    "allow-get-authorization-status",
    "allow-begin-authorization",
    "allow-cancel-authorization",
    "allow-disconnect-authorization",
    "allow-get-monitoring-health",
    "allow-start-monitoring",
    "allow-stop-monitoring",
    "allow-check-monitoring-now",
    "allow-copy-code",
    "allow-copy-code-with-expiry",
    "allow-quit-app",
    "allow-hide-window",
    "allow-extract-provider",
    "allow-get-clipboard-config",
    "allow-set-clipboard-timeout",
    "allow-get-privacy-data",
    "allow-clear-history",
    "allow-get-preferences",
    "allow-set-auto-copy-enabled",
    "allow-set-provider-auto-copy"
  ]
}
